        <item name="android:colorBackground">@color/mocha_bg</item>
        <item name="android:windowBackground">@color/mocha_bg</item>
        <item name="android:textColorPrimary">@color/mocha_text_primary</item>
        <item name="android:textColorSecondary">@color/mocha_text_secondary</item>
        <item name="android:statusBarColor">@color/mocha_bg</item>
        <item name="android:navigationBarColor">@color/mocha_bg</item>
    </style>

    <style name="Theme.RetroLauncher.Mocha.Home" parent="Theme.RetroLauncher.Mocha">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>

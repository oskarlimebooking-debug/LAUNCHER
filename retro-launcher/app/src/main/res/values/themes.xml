<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.RetroLauncher" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- T2.7 — substitute Material's view inflater with a wrapper that catches
             the ArrayIndexOutOfBoundsException Material Components 1.11.0 throws on
             API 23-25 head units. AppCompatDelegate reads this before factory2 is
             locked, which is the only place substitution is reliable on API 23. -->
        <item name="viewInflaterClass">com.oskar.retrolauncher.SafeMaterialComponentsViewInflater</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/bg</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@color/bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds" tools:targetApi="21">true</item>
        <item name="fontFamily">sans-serif</item>
    </style>

    <!-- Variant for the launcher home: fully transparent SystemUI, hides everything -->
    <style name="Theme.RetroLauncher.Home" parent="Theme.RetroLauncher">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- For preferences screens — keep AppBar visible -->
    <style name="Theme.RetroLauncher.Preferences" parent="PreferenceThemeOverlay">
        <item name="preferenceCategoryTitleTextColor">@color/accent</item>
    </style>

    <!-- Mocha — warm earth tones -->
    <style name="Theme.RetroLauncher.Mocha" parent="Theme.RetroLauncher">

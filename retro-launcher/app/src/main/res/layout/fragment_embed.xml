<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tile">

    <!-- VirtualDisplay rendering surface (system flavor) -->
    <TextureView
        android:id="@+id/embed_texture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Fallback for standard flavor and before VirtualDisplay is ready -->
    <TextView
        android:id="@+id/embed_placeholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="@string/embed_v03_placeholder"
        android:textColor="@color/text_tertiary"
        android:textSize="14sp" />
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tile">

    <!-- Default content: cyberpunk-HUD location panel (range rings, trail,
         compass, corner readouts). Native View, no WebView — sharedUserId=
         system forbids WebView in privileged processes on API 23+. -->
    <com.oskar.retrolauncher.ui.embed.LocationHudView
        android:id="@+id/embed_hud"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- VirtualDisplay surface — only used on system flavor + API 26+ when an
         embed app is configured. Hidden by default; launchEmbedded() toggles it. -->
    <TextureView
        android:id="@+id/embed_texture"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>

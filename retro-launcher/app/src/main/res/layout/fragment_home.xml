<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Vertical guideline reflecting the panel split set by MainActivity -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/home_split"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.40" />

    <!-- Left column: media tile (top) + weather tile (bottom) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/media_slot"
        android:name="com.oskar.retrolauncher.ui.media.MediaFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/home_split"
        app:layout_constraintBottom_toTopOf="@id/weather_slot"
        app:layout_constraintVertical_chainStyle="packed" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/weather_slot"
        android:name="com.oskar.retrolauncher.ui.weather.WeatherFragment"
        android:layout_width="0dp"
        android:layout_height="@dimen/weather_tile_height"
        android:layout_margin="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/home_split"
        app:layout_constraintTop_toBottomOf="@id/media_slot"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Right column: ViewPager swipes between embed / grid / trips -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/right_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@id/home_split"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/dots" />

    <com.oskar.retrolauncher.ui.home.DotsIndicator
        android:id="@+id/dots"
        android:layout_width="0dp"
        android:layout_height="20dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintStart_toStartOf="@id/home_split"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

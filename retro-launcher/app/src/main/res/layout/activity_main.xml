<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Left rail with pinned apps -->
    <FrameLayout
        android:id="@+id/app_rail"
        android:layout_width="@dimen/rail_width"
        android:layout_height="0dp"
        android:background="@color/bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/status_bar_container">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rail_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
    </FrameLayout>

    <!-- Vertical guideline driving the L/R split (default 40%) -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/panel_split"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.40" />

    <!-- Top container: HomeFragment is added programmatically in MainActivity.onCreate. -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/home_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/app_rail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/status_bar_container" />

    <!-- Bottom strip: StatusBarFragment is added programmatically. -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/status_bar_container"
        android:layout_width="0dp"
        android:layout_height="@dimen/status_bar_height"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

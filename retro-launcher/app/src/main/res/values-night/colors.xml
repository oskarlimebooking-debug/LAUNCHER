    <color name="accent">#FF8500</color>
    <color name="accent_dim">#B25A00</color>

    <color name="text_primary">#FFFFFF</color>
    <color name="text_secondary">#B3B3B3</color>
    <color name="text_tertiary">#888888</color>
    <color name="text_disabled">#555555</color>

    <color name="track">#1F1F1F</color>
    <color name="warn">#FFC107</color>
